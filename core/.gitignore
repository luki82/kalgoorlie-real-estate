# .gitignore
# --- Python & Django ---
*.pyc
__pycache__/
*.log
db.sqlite3
.env

# --- Virtual Environments ---
/django_env
/venv
/env

# --- Media & Static ---
# Ignore user-uploaded files (Media), but KEEP site design assets (Static)
/media/

# --- Operating System Junk ---
.DS_Store
Thumbs.db

# --- Editor Settings 
.vscode/
.idea/
# --- Portfolio ---
# Original PDFs stay on your computer; only the web images in static/portfolio/ are pushed
/portfolio_pdfs/*.pdf

# --- Built by collectstatic (Render builds this itself) ---
/staticfiles/
